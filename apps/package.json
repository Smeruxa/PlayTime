{
    "name": "@playtime/services",
    "version": "1.0.0",
    "scripts": {
        "start": "npm start --workspace @playtime/gateway",
        "start:legacy": "tsx gateway/legacy.ts",
        "dev:legacy": "nodemon --exec tsx gateway/legacy.ts",
        "dev:services": "node --import tsx shared/runtime/startStack.ts",
        "grant:services": "node --import tsx database/grantRoles.ts",
        "typecheck": "tsc --noEmit",
        "init-db": "psql -U $PG_USER -h $PG_HOST -d $PG_DATABASE -f database/schema.sql",
        "migrate": "tsx database/runMigrations.ts",
        "admin:key": "node --import tsx -- gateway/admin/configureAdminAccess.ts"
    },
    "dependencies": {
        "@jitsi/rnnoise-wasm": "^0.2.1",
        "bcrypt": "^6.0.0",
        "cors": "^2.8.6",
        "dotenv": "^17.4.1",
        "emoji-regex": "^10.6.0",
        "express": "^5.2.1",
        "express-rate-limit": "^8.3.2",
        "helmet": "^8.1.0",
        "ioredis": "^5.10.1",
        "jsonwebtoken": "^9.0.3",
        "multer": "^2.1.1",
        "nodemailer": "^10.2.1",
        "pg": "^8.20.0",
        "rate-limit-redis": "^4.3.1",
        "socket.io": "^4.8.3",
        "ws": "^8.20.0"
    },
    "devDependencies": {
        "@types/bcrypt": "^6.0.0",
        "@types/express": "^5.0.6",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/multer": "^2.1.0",
        "@types/node": "^25.6.0",
        "@types/nodemailer": "^8.0.2",
        "@types/pg": "^8.20.0",
        "nodemon": "^3.1.14",
        "tsx": "^4.21.0",
        "typescript": "^6.0.3"
    },
    "overrides": {
        "minimatch@>=7 <11.0.1": "^11.0.9",
        "esbuild": "^0.28.2"
    },
    "private": true,
    "workspaces": [
        "auth-api",
        "chat-api",
        "room-api",
        "gateway"
    ]
}
