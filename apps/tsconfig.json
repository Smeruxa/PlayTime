{
    "compilerOptions": {
        "target": "ES2020",
        "module": "Node16",
        "moduleResolution": "node16",
        "strict": true,
        "noEmit": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "resolveJsonModule": true,
        "allowJs": true,
        "checkJs": false,
        "rootDir": "."
    },
    "include": [
        "auth-api/**/*.ts",
        "chat-api/**/*.ts",
        "room-api/**/*.ts",
        "gateway/**/*.ts",
        "shared/**/*.ts",
        "database/**/*.ts"
    ],
    "exclude": [
        "node_modules"
    ]
}
