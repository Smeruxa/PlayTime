{
    "name": "playtime-mobile",
    "version": "2.0.21",
    "private": true,
    "overrides": {
        "minimatch@>=7 <11.0.1": "^11.0.9"
    },
    "scripts": {
        "android": "bash scripts/run-android.sh",
        "lint": "eslint src App.tsx index.js --ext .ts,.tsx,.js --max-warnings 0",
        "start": "react-native start",
        "test": "npm run test:unit && npm run test:protocol",
        "typecheck": "tsc --noEmit",
        "build:android": "bash scripts/android.sh assembleDebug",
        "build:release": "bash scripts/android.sh assembleRelease",
        "lint:fix": "npm run lint -- --fix",
        "format": "prettier --write \"src/**/*.{ts,tsx}\" \"tests/**/*.ts\" \"scripts/*.cjs\" \"e2e/*.cjs\" \"*.{js,json,tsx}\" .eslintrc.js .prettierrc.js",
        "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"tests/**/*.ts\" \"scripts/*.cjs\" \"e2e/*.cjs\" \"*.{js,json,tsx}\" .eslintrc.js .prettierrc.js",
        "check": "npm run format:check && npm run lint && npm run typecheck && npm run typecheck:tests",
        "setup:android": "bash scripts/bootstrap-android.sh",
        "emulator:android": "bash scripts/emulator.sh",
        "build:preview": "bash scripts/android.sh assemblePreview",
        "postinstall": "node scripts/patch-webrtc.cjs",
        "format:android": "bash scripts/format-android.sh",
        "format:android:check": "bash scripts/format-android.sh --check",
        "lint:android": "bash scripts/android.sh :app:lintDebug",
        "test:unit": "jest --runInBand",
        "test:protocol": "node --import tsx --test tests/services.test.ts tests/home-resilience.test.ts tests/peer-identity.test.ts tests/playback.test.ts tests/chat-layout.test.ts tests/push-registration.test.ts tests/auth-flow.test.ts",
        "test:e2e": "python3 e2e/run-ui.py",
        "test:calls": "python3 e2e/run-calls.py",
        "sync:emoji": "node scripts/sync-emoji.cjs",
        "test:android:native": "bash scripts/test-native.sh",
        "typecheck:tests": "tsc -p tsconfig.tests.json --noEmit",
        "build:rustore": "bash scripts/build-rustore.sh"
    },
    "dependencies": {
        "@react-native-async-storage/async-storage": "^3.1.1",
        "react": "19.3.0",
        "react-native": "0.88.1",
        "react-native-get-random-values": "^2.1.0",
        "react-native-keychain": "^11.0.0",
        "react-native-safe-area-context": "^5.5.2",
        "react-native-svg": "^15.16.1",
        "react-native-webrtc": "155.0.1",
        "socket.io-client": "^4.8.4",
        "tweetnacl": "^1.0.3",
        "tweetnacl-util": "^0.15.1"
    },
    "devDependencies": {
        "@babel/core": "^7.25.2",
        "@babel/preset-env": "^7.25.3",
        "@babel/runtime": "^7.25.0",
        "@react-native-community/cli": "20.2.0",
        "@react-native-community/cli-platform-android": "20.2.0",
        "@react-native/babel-preset": "0.88.1",
        "@react-native/eslint-config": "0.88.1",
        "@react-native/jest-preset": "0.88.1",
        "@react-native/metro-config": "0.88.1",
        "@react-native/typescript-config": "0.88.1",
        "@types/jest": "^29.5.13",
        "@types/react": "^19.2.0",
        "@types/react-test-renderer": "^19.1.0",
        "eslint": "^8.19.0",
        "jest": "^29.6.3",
        "prettier": "2.8.8",
        "react-test-renderer": "19.3.0",
        "typescript": "^6.0.3",
        "tsx": "^4.21.0"
    },
    "engines": {
        "node": ">= 22.11.0"
    }
}
