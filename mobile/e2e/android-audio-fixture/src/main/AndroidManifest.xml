<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <application android:label="PlayTime Audio Fixture" android:theme="@android:style/Theme.Material.Light.NoActionBar" android:allowBackup="false" android:allowAudioPlaybackCapture="true">
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service android:name=".ToneService" android:exported="false" android:foregroundServiceType="mediaPlayback" />
    </application>
</manifest>
