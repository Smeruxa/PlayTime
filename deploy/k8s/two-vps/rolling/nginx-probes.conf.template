server {
    listen 127.0.0.1:18501;
    server_name localhost;
    server_tokens off;
    access_log off;

    resolver ${PLAYTIME_CLUSTER_DNS} valid=2s ipv6=off;
    resolver_timeout 500ms;
    proxy_bind ${PLAYTIME_EDGE_PRIVATE_IP};
    proxy_connect_timeout 500ms;
    proxy_send_timeout 800ms;
    proxy_read_timeout 800ms;
    proxy_next_upstream off;

    location = /primary {
        set $playtime_probe playtime-gateway-0.playtime-pods.playtime.svc.cluster.local:1501;
        proxy_pass http://$playtime_probe/http-readyz;
    }

    location = /secondary {
        set $playtime_probe playtime-gateway-secondary-0.playtime-pods.playtime.svc.cluster.local:1501;
        proxy_pass http://$playtime_probe/http-readyz;
    }

    location / {
        return 404;
    }
}
